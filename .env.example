# FastAPI (read from this root .env when launched from apps/api)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restockos
WEB_ORIGIN=http://localhost:3000
OWNER_TOKEN=
SESSION_SECRET=
AUTOMATION_TOKEN=
DEMO_ENABLED=true
PUBLIC_DEMO=true
SCAN_INTERVAL_SECONDS=0
ADMIN_ACCOUNT_IDS=[]
AUTH_RECIPIENT=localhost

# Public NEAR Testnet RPC and contract. Set these before seeding.
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=
NEAR_AGENT_ID=
NEAR_AGENT_PRIVATE_KEY=
DEMO_SUPPLIER_ACCOUNTS=

# Optional OpenAI-compatible tool calling
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Export in the shell or set in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
